{ lib
, buildFHSEnv
, appimageTools
, fetchurl
, writeShellScript
, writeText
}:

let
  pname = "roastime";
  version = "4.14.3"; # Adjust version if needed

  src = fetchurl {
    url = "https://aillio.com/downloads/linux/${pname}-${version}.AppImage";
    # Keep your existing hash here
    hash = "sha256-sAG7kPUcfh8wXgbIgyPYFxa8ATMeoeyOoMG76LeDol8=";
  };

  appimageContents = appimageTools.extractType2 {
    inherit pname version src;
  };
in
buildFHSEnv {
  inherit pname version;

  targetPkgs = pkgs: with pkgs; [
    # Core C/C++ runtime & dynamic linker
    glibc
    stdenv.cc.cc.lib
    zlib

    # Hardware & USB communication
    libusb1
    systemd # provides libudev

    # Electron / Chromium runtime dependencies
    alsa-lib
    at-spi2-atk
    at-spi2-core
    atk
    cairo
    cups
    dbus
    expat
    fontconfig
    freetype
    gdk-pixbuf
    glib
    gtk3
    mesa
    nspr
    nss
    pango
    libxkbcommon
    xorg.libX11
    xorg.libXcomposite
    xorg.libXcursor
    xorg.libXdamage
    xorg.libXext
    xorg.libXfixes
    xorg.libXi
    xorg.libXrandr
    xorg.libXrender
    xorg.libXtst
    xorg.libxcb
  ];

  # Launch the extracted AppRun inside the FHS environment
  runScript = writeShellScript "roastime-run" ''
    exec ${appimageContents}/AppRun "$@"
  '';

  extraInstallCommands = ''
    mkdir -p $out/share/applications
    mkdir -p $out/share/icons

    # Install desktop entry
    install -m 444 -D ${appimageContents}/roastime.desktop $out/share/applications/roastime.desktop
    substituteInPlace $out/share/applications/roastime.desktop \
      --replace-quiet 'Exec=AppRun' "Exec=$out/bin/${pname}" || true

    # Install icons
    cp -r ${appimageContents}/usr/share/icons $out/share/ 2>/dev/null || true
  '';

  meta = with lib; {
    description = "Roast profile logging software for Aillio Bullet R1";
    homepage = "https://roast.world";
    platforms = [ "x86_64-linux" ];
    license = licenses.unfree;
  };
}
